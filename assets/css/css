/* ライトモード（ダークモード以外）の背景色をベージュに設定 */
:root:not(.dark),
body:not(.dark) {
  --hb-background: #f7f5f0 !important;
  --hb-surface: #efece4 !important;
  background-color: #f7f5f0 !important;
}

/* ヘッダーやナビゲーションバーの背景色を合わせる */
:root:not(.dark) header,
:root:not(.dark) nav {
  background-color: #f7f5f0 !important;
}
